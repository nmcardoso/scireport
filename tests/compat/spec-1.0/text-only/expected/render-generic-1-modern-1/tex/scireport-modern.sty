\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{scireport-modern}[2026/10/11 scireport modern layout (Publication), version 1]
%
% Works with LuaLaTeX (default), XeLaTeX and pdfLaTeX. TeX Gyre Pagella (text), Heros (headings)
% and Cursor (code) are loaded from the fonts/ folder of the project through fontspec; pdfLaTeX
% loads the same families from the TeX Gyre packages of TeX Live.
%
% Geometry: A4 with 22 mm sides and 25 mm top and bottom. The text spans the whole frame.
% \scoverhang (0 pt) and \scfullwidth are kept for the components that reach into the margin.
\RequirePackage{iftex}
\RequirePackage{etoolbox}

\DeclareOption{a4}{\def\sc@paper{a4paper}}
\DeclareOption{letter}{\def\sc@paper{letterpaper}}
\ExecuteOptions{a4}
\ProcessOptions\relax

% ---- fonts -------------------------------------------------------------------------------------
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{textcomp}
  \RequirePackage{tgpagella}
  \RequirePackage[scale=1]{tgheros}
  \RequirePackage[scale=0.95]{tgcursor}
\else
  \RequirePackage{fontspec}
  \setmainfont{TeXGyrePagella}[Path=./fonts/, Extension=.otf, Ligatures=TeX,
    UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-Bold, BoldItalicFont=*-BoldItalic]
  \setsansfont{TeXGyreHeros}[Path=./fonts/, Extension=.otf, Ligatures=TeX,
    UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-Bold, BoldItalicFont=*-Bold]
  \setmonofont{TeXGyreCursor}[Path=./fonts/, Extension=.otf, Scale=0.95,
    UprightFont=*-Regular, ItalicFont=*-Regular, BoldFont=*-Regular, BoldItalicFont=*-Regular]
\fi
% The page is set in sans (Heros); \scbody switches to the justified Pagella of running prose.
\RequirePackage{ragged2e}

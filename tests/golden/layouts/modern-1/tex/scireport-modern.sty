% ---- type scale: 10 pt body on a 1.5 line height -----------------------------------------------
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize{10}{15}%
  \abovedisplayskip 10\p@ \@plus 2\p@ \@minus 2\p@
  \abovedisplayshortskip 4\p@ \@plus 2\p@
  \belowdisplayskip \abovedisplayskip
  \belowdisplayshortskip \abovedisplayshortskip
  \let\@listi\@listI}
\renewcommand{\small}{\@setfontsize\small{8.5}{12.5}\let\@listi\@listI}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize{8}{12}\let\@listi\@listI}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize{7.5}{11}}
\newcommand{\sc@zero}[1]{\ifnum#1<10 0\fi\number#1\relax}

\color{sc-ink}
\setlength{\parindent}{0pt}
\setlength{\parskip}{9pt}
\setlength{\emergencystretch}{3em}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{scireport-modern}[2026/10/09 scireport modern layout (Signal), version 1]
%
% Works with LuaLaTeX (default), XeLaTeX and pdfLaTeX. Inter and IBM Plex Mono are loaded from the
% fonts/ folder of the project through fontspec; pdfLaTeX cannot read OpenType fonts, so it falls
% back to Latin Modern with a warning (W901).
%
% Geometry: 16 mm sides; the text column (140 mm on A4) is narrower than the 178 mm page frame, as
% the paragraphs of the HTML look are (max-width: 70ch). Tables, figures, metrics, status boxes and
% flows use the full frame width, \scfullwidth, by reaching \scoverhang into the right margin.
\RequirePackage{iftex}
\RequirePackage{etoolbox}

\DeclareOption{a4}{\def\sc@paper{a4paper}}
\DeclareOption{letter}{\def\sc@paper{letterpaper}}
\ExecuteOptions{a4}
\ProcessOptions\relax

% ---- fonts -------------------------------------------------------------------------------------
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{lmodern}
  \RequirePackage{textcomp}
  \renewcommand{\familydefault}{\sfdefault}
  \PackageWarningNoLine{scireport-modern}{%
    W901: pdfLaTeX cannot load the OpenType fonts Inter and IBM Plex Mono; using Latin Modern Sans
    and Typewriter. Use LuaLaTeX or XeLaTeX for the designed look}
  \newcommand{\sctrack}[1]{#1}
  \newcommand{\sctrackon}{}
  \newcommand{\sctrackby}[2]{#2}
  \newcommand{\sctrackonby}[1]{}
  \newcommand{\scmedium}{}
\else
  \RequirePackage{lmodern}
  \RequirePackage{fontspec}
  \setmainfont{Inter}[Path=./fonts/, Extension=.otf, Ligatures=TeX,
    UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-SemiBold, BoldItalicFont=*-Italic]
  \setsansfont{Inter}[Path=./fonts/, Extension=.otf, Ligatures=TeX,
    UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-SemiBold, BoldItalicFont=*-Italic]
  \setmonofont{IBMPlexMono}[Path=./fonts/, Extension=.otf, Scale=MatchLowercase,
    UprightFont=*-Regular, ItalicFont=*-Regular, BoldFont=*-Medium, BoldItalicFont=*-Medium]
  \newcommand{\sctrack}[1]{{\addfontfeatures{LetterSpace=8}#1}}
  \newcommand{\sctrackon}{\addfontfeatures{LetterSpace=8}}
  % Tracking by a given amount, in percent of the em (negative: tighter).
  \newcommand{\sctrackby}[2]{{\addfontfeatures{LetterSpace=#1}#2}}
  \newcommand{\sctrackonby}[1]{\addfontfeatures{LetterSpace=#1}}
  \newfontfamily\scmedium[Path=./fonts/, Extension=.otf, Ligatures=TeX,
    BoldFont=Inter-SemiBold]{Inter-Medium}
  % The vendored subsets have no bullet glyph.
  \renewcommand{\textbullet}{\ensuremath{\bullet}}
  % ... and no curly quotes, which the TeX ligatures of XeTeX would make of a typed backtick: print
  % that one character as it is (LuaTeX does not report it).
  \ifXeTeX
    \begingroup\catcode`\`=\active
    \gdef\sc@grave{\ifmmode\mathchar"0060 \else{\addfontfeatures{Mapping=}\symbol{96}}\fi}
    \gdef\sc@activategrave{\catcode96=\active \let`\sc@grave}
    \endgroup
    \AtBeginDocument{\sc@activategrave}
  \fi
\fi



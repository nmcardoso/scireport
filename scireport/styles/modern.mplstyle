# Matplotlib rcParams of every figure drawn in the modern@1 look: TeX Gyre Heros, ink spines on the
# left and bottom only, a hairline horizontal grid, the steel-blue and gold series colours. Applied only inside
# scireport.mplstyle(), never globally. The colours are copied by hand from
# scireport/layouts/modern/1/palette.yaml and checked against it by
# tests/unit/styles/test_consistency.py; the file is frozen with the layout (ADR-0008).

font.family: sans-serif
font.sans-serif: TeXGyreHerosSubset, TeXGyreHeros, TeX Gyre Heros, Helvetica Neue, Arial, sans-serif
font.monospace: TeXGyreCursorSubset, TeXGyreCursor, TeX Gyre Cursor, Courier New, Courier, monospace
font.size: 8.0

axes.facecolor: "#ffffff"
axes.edgecolor: "#111111"
axes.labelcolor: "#111111"
axes.titlecolor: "#111111"
axes.titleweight: 700
axes.titlelocation: left
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.prop_cycle: cycler('color', ["#1f4e79", "#c8961e", "#00897b", "#d35400", "#6a3d9a", "#6b7782"])

grid.color: "#d5dbe0"
grid.linewidth: 0.5
grid.alpha: 1.0

xtick.color: "#444b52"
ytick.color: "#444b52"
xtick.labelsize: 7.5
ytick.labelsize: 7.5

text.color: "#111111"

legend.frameon: False
legend.fontsize: 7.5

figure.facecolor: "#ffffff"
figure.edgecolor: "#ffffff"

savefig.facecolor: "#ffffff"
savefig.edgecolor: "#ffffff"

image.cmap: cividis

lines.linewidth: 1.4
lines.markersize: 4.0

patch.edgecolor: "#ffffff"
patch.linewidth: 0.5

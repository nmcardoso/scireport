((=- LaTeX components of modern@1 (Signal). Delimiters: ((* block *)), ((( variable ))), ((= comment =)).
     Most of the typesetting is in scireport-modern.sty; the macros here only choose and fill it.
     A line that ends with a block tag loses its newline; (((eol))) puts it back. -=))
((* set lp = '(' *))
((* set rp = ')' *))

((* macro chapter(title, entry, page_break) *))
((* set flow = (0 if page_break else 1) if page_break is not none else (0 if options.chapter_breaks else 1) *))
\scchapter{(((('%02d' % (entry.number | int)) if entry.number else '')))}{(((title)))}{(((entry.anchor)))}{(((title | pdfstring)))}{(((flow)))}

((* endmacro *))

((* macro heading(text, level, entry, page_break) *))
\scheading{(((level)))}{(((text)))}{(((entry.anchor)))}{(((text | pdfstring)))}{(((1 if entry.number else 0)))}{(((1 if page_break else 0)))}

((* endmacro *))

((* macro contents(entries) *))
\clearpage
\scanchor{sc-toc}{Contents}{}%
\scsectiontitle{Contents}
((* for e in entries *))
\sctocrow{(((e.level)))}{(((('%02d' % (e.number | int)) if (e.level == 0 and e.number) else '')))}{(((e.text)))}{(((e.anchor)))}
((* endfor *))

((* endmacro *))

((* macro cover(cover) *))
((* if options.cover *))
((* set rows -*))
((* if cover.date *))DATE & (((cover.date)))\\(((eol)))((* endif *))
((* if cover.version *))VERSION & (((cover.version)))\\(((eol)))((* endif *))
((* if meta.keywords *))KEYWORDS & (((meta.keywords | join(', '))))\\(((eol)))((* endif *))
((*- endset *))
\sccover{(((cover.pipeline)))}{(((cover.title)))}{(((cover.subtitle)))}{((* for a in cover.authors *))(((a)))\par ((* endfor *))}{(((rows | safe)))}
((* else *))
\sctitleblock{(((cover.title)))}{(((cover.subtitle)))}
((* endif *))

((* endmacro *))

((* macro tcol(col, strip, bar) -*))
((* set w = '\\dimexpr ' ~ (col.width | round(5)) ~ '\\sctablew-2\\tabcolsep-' ~ strip ~ 'pt\\relax' -*))
(((bar | safe)))((* if col.align == 'right' *))>{\raggedleft\arraybackslash\fontsize{7.5}{9}\ttfamily\selectfont}p{(((w | safe)))}((* elif col.align == 'center' *))>{\centering\arraybackslash}p{(((w | safe)))}((* elif col.align == 'path' *))>{\raggedright\arraybackslash\fontsize{7.5}{9}\ttfamily\selectfont}p{(((w | safe)))}((* else *))>{\raggedright\arraybackslash}p{(((w | safe)))}((* endif *))
((*- endmacro *))

((* macro head_row(spec) -*))
((* for col in spec.columns *)){\fontsize{7}{9}\selectfont\bfseries\color{sc-ink}\sctrackby{8}{\MakeUppercase{(((col.label)))}}((* if col.unit *)) {\mdseries\color{sc-gray-500}\sctrackonby{0}(((lp)))(((col.unit)))(((rp)))}((* endif *))}((* if not loop.last *)) & ((* endif *))((* endfor *))
((*- endmacro *))

((* macro body_row(spec, row) -*))
((* set tints = {'pass': ['sc-green-light', '@{{\\color{sc-ink}\\vrule width 3pt}\\hskip 4pt}', 1], 'warn': ['sc-accent-light', '@{{\\color{sc-accent}\\vrule width 3pt}\\hskip 4pt}', 1], 'fail': ['sc-red-light', '@{{\\color{sc-accent-ink}\\vrule width 2pt}\\kern 1pt{\\color{sc-accent-ink}\\vrule width 2pt}\\hskip 4pt}', 3]} *))
((* if row.verdict *))\rowcolor{(((tints[row.verdict][0] | safe)))}((* endif *))((* for cell in row.cells *))((* set style = row.emphasis[loop.index0] *))((* set col = spec.columns[loop.index0] *))((* if loop.first and row.verdict *))\multicolumn{1}{(((tcol(col, tints[row.verdict][2], tints[row.verdict][1]))))}{\scverdictmark{(((row.verdict | safe)))}((* endif *))((* if style == 'strong' or style in ('pass', 'warn', 'fail') *)){\bfseries (((cell)))}((* elif style == 'muted' *))\textcolor{sc-gray-500}{(((cell)))}((* elif col.align == 'path' *))(((cell | breakable)))((* else *))(((cell)))((* endif *))((* if loop.first and row.verdict *))}((* endif *))((* if not loop.last *)) & ((* endif *))((* endfor *))
((*- endmacro *))

((* macro table(spec) *))
((* if not spec.rows *))
\emph{Nothing recorded.}\par

((* else *))
{\fontsize{8}{11}\selectfont\renewcommand{\arraystretch}{1.65}\setlength{\tabcolsep}{6pt}
\setlength{\sctablew}{\scfullwidth}
\begin{longtable}{((* for col in spec.columns *))(((tcol(col, 0, ''))))((* endfor *))}
\sctoprule
(((head_row(spec)))) \\
\scheadrule
\endfirsthead
\sctoprule
(((head_row(spec)))) \\
\scheadrule
\endhead
\sctoprule
\endlastfoot
((* for row in spec.rows *))
(((body_row(spec, row)))) \\
((* if not loop.last *))\scrowrule
((* endif *))((* endfor *))
\end{longtable}}
((* if spec.truncated *))
{\fontsize{8.5}{13}\selectfont\color{sc-ink-soft}Showing the first (((spec.rows | length | fmt_int))) of (((spec.total | fmt_int))) rows.((* if spec.overflow *)) All rows: \texttt{(((spec.overflow.href | breakable)))}.((* endif *))}\par
((* endif *))
((* if spec.caption *))
\begin{adjustwidth}{0pt}{-\scoverhang}\vspace{-1pt}((* if spec.number *))\setcounter{table}{(((spec.number - 1)))}((* endif *))\captionof{table}{(((spec.caption)))}\end{adjustwidth}
((* endif *))
((* endif *))

((* endmacro *))

((* macro figure(spec) *))
\begin{adjustwidth}{0pt}{-\scoverhang}
\begin{samepage}
\vspace{14pt}\centering
\includegraphics[width=(((spec.width)))\linewidth]{(((spec.src | safe)))}\par\nobreak
% alt: (((spec.alt | replace('\n', ' '))))
((* if spec.caption *))
\vspace{7pt}\nobreak\scrule{sc-ink}{0.5pt}\vspace{5pt}\nobreak
\setcounter{figure}{(((spec.number - 1)))}\captionof{figure}{(((spec.caption)))}
((* endif *))
\vspace{12pt}
\end{samepage}
\end{adjustwidth}

((* endmacro *))

((* macro image(spec) *))
\begin{adjustwidth}{0pt}{-\scoverhang}
\begin{samepage}
\vspace{14pt}\centering
\includegraphics[width=(((spec.width)))\linewidth]{(((spec.src | safe)))}\par\nobreak
% alt: (((spec.alt | replace('\n', ' '))))
((* if spec.caption *))
\vspace{7pt}\nobreak\scrule{sc-ink}{0.5pt}\vspace{5pt}\nobreak
{\raggedright\fontsize{8.5}{12}\selectfont\color{sc-ink-soft}(((spec.caption)))\par}
((* endif *))
\vspace{12pt}
\end{samepage}
\end{adjustwidth}

((* endmacro *))

((* macro equation(spec) *))
((* if spec.number *))
\begin{equation}
(((spec.body)))
\end{equation}
((* else *))
\[
(((spec.body)))
\]
((* endif *))
((* if spec.caption *))
{\fontsize{8.5}{12}\selectfont\color{sc-ink-soft}(((spec.caption)))\par}
((* endif *))

((* endmacro *))

((* macro metrics(entries) *))
\begin{adjustwidth}{0pt}{-\scoverhang}
\vspace{14pt}\noindent
((* for row in entries | batch(3) *))
\begin{tabular}[t]{@{}p{\dimexpr(\linewidth-44pt)/3\relax}@{\hspace{22pt}}p{\dimexpr(\linewidth-44pt)/3\relax}@{\hspace{22pt}}p{\dimexpr(\linewidth-44pt)/3\relax}@{}}
((* for m in row *))\scmetricvalue{(((m.label)))}{(((m.value)))}{(((m.detail)))}((* if not loop.last *)) & ((* endif *))((* endfor *))((* for _ in range(3 - (row | length)) *)) & ((* endfor *)) \\
\end{tabular}\par\vspace{20pt}
((* endfor *))
\end{adjustwidth}

((* endmacro *))

((* macro status(level, headline, detail) *))
\begin{adjustwidth}{0pt}{-\scoverhang}\begin{scstatusbox}{(((level | safe)))}
\scstatusmark{(((level | safe)))}\hspace{9pt}{\fontsize{12.5}{16}\selectfont\bfseries\sctrackonby{2}\MakeUppercase{(((headline)))}}((* if detail *))\par\vspace{5pt}{\fontsize{9.5}{14}\selectfont\color{sc-ink-soft}(((detail)))}((* endif *))(((eol)))
\end{scstatusbox}\end{adjustwidth}\par

((* endmacro *))

((* macro alert(level, text) *))
\begin{adjustwidth}{0pt}{-\scoverhang}\begin{scalertbox}{(((level | safe)))}
\scchip{(((level | safe)))}\hspace{10pt}(((text)))(((eol)))
\end{scalertbox}\end{adjustwidth}\par

((* endmacro *))

((* macro flow(stages) *))
\vspace{14pt}
\begin{adjustwidth}{0pt}{-\scoverhang}
((* for s in stages *))
\begin{scflowstage}{(((s.state | safe)))}
\noindent\begin{tabular}[t]{@{}p{30pt}@{}p{\dimexpr\linewidth-30pt\relax}@{}}
\leavevmode{\color{sc-ink}\fontsize{12}{16}\ttfamily\bfseries\selectfont (((('%02d' % s.number))))} & \leavevmode{\fontsize{10}{14}\selectfont\bfseries\sctrackonby{2}\MakeUppercase{(((s.label)))}}\hspace{10pt}\scflowtag{(((s.state | safe)))}((* for line in s.detail *))\par{\fontsize{8.5}{12}\selectfont\color{sc-ink-soft}(((line)))}((* endfor *)) \\
\end{tabular}%
\end{scflowstage}\par
((* endfor *))
\end{adjustwidth}
\vspace{14pt}

((* endmacro *))

((* macro metadata(entries) *))
{\fontsize{8}{12}\selectfont
\begin{adjustwidth}{0pt}{-\scoverhang}
\vspace{10pt}\noindent
\begin{tabular}[t]{@{}>{\fontsize{7.5}{11}\ttfamily\selectfont\raggedright\arraybackslash\leavevmode\color{sc-ink-soft}}p{\dimexpr0.32\linewidth-12pt\relax}@{\hspace{12pt}}>{\ttfamily\raggedright\arraybackslash}p{\dimexpr0.68\linewidth\relax}@{}}
\scmetatop
((* for label, value in entries *))
\rule{0pt}{11pt}\MakeUppercase{(((label)))} & \rule{0pt}{11pt}(((value))) \\[3pt]
\scmetarule
((* endfor *))
\end{tabular}\par\vspace{12pt}
\end{adjustwidth}}

((* endmacro *))

((* macro bullets(items, ordered) *))
((* set env = 'enumerate' if ordered else 'itemize' *))
\begin{(((env | safe)))}
((* for item in items *))
\item (((item)))
((* endfor *))
\end{(((env | safe)))}

((* endmacro *))

((* macro code(source, language, caption, fence, verbatim) *))
\vspace{12pt}
((* if language *))
{\color{sc-accent-ink}\fontsize{7}{10}\ttfamily\bfseries\selectfont\sctrackby{12}{\MakeUppercase{(((language)))}}\par}\vspace{3pt}
((* endif *))
\begin{adjustwidth}{0pt}{-\scoverhang}\begin{sccodebox}
\fontsize{8}{12}\ttfamily\selectfont
\begin{verbatim}
(((verbatim)))
\end{verbatim}
\end{sccodebox}\end{adjustwidth}
((* if caption *))
{\fontsize{8.5}{12}\selectfont\color{sc-ink-soft}(((caption)))\par}
((* endif *))

((* endmacro *))

((* macro details(summary, body) *))
\begin{scdetailsbox}
{\fontsize{8}{12}\ttfamily\bfseries\selectfont\sctrackby{8}{\MakeUppercase{(((summary)))}}}\par\vspace{8pt}
(((body)))
\end{scdetailsbox}\par

((* endmacro *))

((* macro note(body) *))

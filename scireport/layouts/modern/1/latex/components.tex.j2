((=- LaTeX components of modern@1 (the journal-style look). Delimiters: ((* block *)), ((( variable ))), ((= comment =)).
     Most of the typesetting is in scireport-modern.sty; the macros here only choose and fill it.
     A line that ends with a block tag loses its newline; (((eol))) puts it back. -=))
((* set lp = '(' *))
((* set rp = ')' *))
((* set rails = {'done': 'sc-green', 'reused': 'sc-blue', 'running': 'sc-cyan', 'failed': 'sc-red', 'skipped': 'sc-gray-500', 'pending': 'sc-accent'} *))

((* macro chapter(title, entry, page_break) *))
((* set flow = (0 if page_break else 1) if page_break is not none else (0 if options.chapter_breaks else 1) *))
\scchapter{(((entry.number or '')))}{(((title)))}{(((entry.anchor)))}{(((title | pdfstring)))}{(((flow)))}

((* endmacro *))

((* macro heading(text, level, entry, page_break) *))
\scheading{(((level)))}{(((text)))}{(((entry.anchor)))}{(((text | pdfstring)))}{(((1 if entry.number else 0)))}{(((1 if page_break else 0)))}{(((entry.number or '')))}

((* endmacro *))

((* macro contents(entries) *))
\clearpage
\scanchor{sc-toc}{Contents}{}%
{\raggedright\sffamily\bfseries\fontsize{17.28}{21}\selectfont\color{sc-navy}Contents\par}\vspace{8pt}
((* for e in entries *))
\sctocrow{(((e.level)))}{(((e.number or '')))}{(((e.text)))}{(((e.anchor)))}
((* endfor *))
\clearpage

((* endmacro *))

((* macro cover(cover) *))
((* if options.cover *))
((* set rows -*))
((* if cover.authors *))Authors & (((cover.authors | join('; '))))\\(((eol)))((* endif *))
((* if cover.date *))Date & (((cover.date)))\\(((eol)))((* endif *))
((* if cover.version *))Version & (((cover.version)))\\(((eol)))((* endif *))
((* if meta.keywords *))Keywords & (((meta.keywords | join(', '))))\\(((eol)))((* endif *))
((*- endset *))
\sccover{(((cover.pipeline)))}{(((cover.title)))}{(((cover.subtitle)))}{((* if meta.abstract *))(((meta.abstract | md)))((* endif *))}{(((rows | safe)))}
((* else *))
\sctitleblock{(((cover.title)))}{(((cover.subtitle)))}
((* endif *))

((* endmacro *))

((* macro tcol(col, strip) -*))
((* set w = '\\dimexpr ' ~ (col.width | round(5)) ~ '\\sctablew-2\\tabcolsep\\relax' -*))
((* if col.align == 'right' *))>{\raggedleft\arraybackslash}p{(((w | safe)))}((* elif col.align == 'center' *))>{\centering\arraybackslash}p{(((w | safe)))}((* elif col.align == 'path' *))>{\raggedright\arraybackslash\fontsize{7.5}{9}\ttfamily\selectfont}p{(((w | safe)))}((* else *))>{\raggedright\arraybackslash}p{(((w | safe)))}((* endif *))
((*- endmacro *))

((* macro head_row(spec) -*))
((* if spec.has_verdicts *)) & ((* endif *))((* for col in spec.columns *)){\sffamily\bfseries (((col.label)))((* if col.unit *))\par{\mdseries\color{sc-gray-500}(((lp)))(((col.unit)))(((rp)))}((* endif *))}((* if not loop.last *)) & ((* endif *))((* endfor *))
((*- endmacro *))

((* macro body_row(spec, row) -*))
((* set tints = {'pass': ['sc-green-light', 'sc-green'], 'warn': ['sc-accent-light', 'sc-accent'], 'fail': ['sc-red-light', 'sc-red']} *))
((* if row.verdict *))\rowcolor{(((tints[row.verdict][0] | safe)))}((* endif *))((* if spec.has_verdicts *))((* if row.verdict *))\cellcolor{(((tints[row.verdict][1] | safe)))}((* endif *)) & ((* endif *))((* for cell in row.cells *))((* set style = row.emphasis[loop.index0] *))((* set col = spec.columns[loop.index0] *))((* if style == 'strong' *)){\bfseries (((cell)))}((* elif style == 'muted' *))\textcolor{sc-gray-500}{(((cell)))}((* elif style == 'pass' *))\textcolor{sc-green}{(((cell)))}((* elif style == 'warn' *))\textcolor{sc-accent-ink}{(((cell)))}((* elif style == 'fail' *))\textcolor{sc-red}{(((cell)))}((* elif col.align == 'path' *))(((cell | breakable)))((* else *))(((cell)))((* endif *))((* if not loop.last *)) & ((* endif *))((* endfor *))
((*- endmacro *))

((* macro table(spec) *))
((* if not spec.rows *))
\emph{Nothing recorded.}\par

((* else *))
((* if spec.caption *))
\par\Needspace{6\baselineskip}\vspace{4pt}((* if spec.number *))\setcounter{table}{(((spec.number - 1)))}((* endif *))\captionof{table}{(((spec.caption)))}\nopagebreak
((* endif *))
{\fontsize{8.5}{10.5}\rmfamily\selectfont\renewcommand{\arraystretch}{1.2}
((* if spec.has_verdicts *))\setlength{\sctablew}{\dimexpr\scfullwidth-3pt\relax}((* else *))\setlength{\sctablew}{\scfullwidth}((* endif *))
\begin{longtable}{((* if spec.has_verdicts *))@{}p{3pt}@{}((* endif *))((* for col in spec.columns *))(((tcol(col))))((* endfor *))}
\sctoprule
(((head_row(spec)))) \\
\scheadrule
\endfirsthead
\sctoprule
(((head_row(spec)))) \\
\scheadrule
\endhead
\scbottomrule
\endfoot
\scbottomrule
\endlastfoot
((* for row in spec.rows *))
(((body_row(spec, row)))) \\
((* endfor *))
\end{longtable}}
((* if spec.truncated *))
{\fontsize{9}{12}\selectfont\color{sc-ink-soft}Showing the first (((spec.rows | length | fmt_int))) of (((spec.total | fmt_int))) rows.((* if spec.overflow *)) All rows: \texttt{(((spec.overflow.href | breakable)))}.((* endif *))}\par
((* endif *))
((* endif *))

((* endmacro *))

((* macro figure(spec) *))
\begin{samepage}
\vspace{10pt}\centering
\includegraphics[width=(((spec.width)))\linewidth]{(((spec.src | safe)))}\par
% alt: (((spec.alt | replace('\n', ' '))))
((* if spec.caption *))
\setcounter{figure}{(((spec.number - 1)))}\captionof{figure}{(((spec.caption)))}
((* endif *))
\vspace{6pt}
\end{samepage}

((* endmacro *))

((* macro image(spec) *))
\begin{samepage}
\vspace{10pt}\centering
\includegraphics[width=(((spec.width)))\linewidth]{(((spec.src | safe)))}\par
% alt: (((spec.alt | replace('\n', ' '))))
((* if spec.caption *))
{\fontsize{9.5}{12}\selectfont\rmfamily (((spec.caption)))\par}
((* endif *))
\vspace{6pt}
\end{samepage}

((* endmacro *))

((* macro equation(spec) *))
((* if spec.number *))
\begin{equation}
(((spec.body)))
\end{equation}
((* else *))
\[
(((spec.body)))
\]
((* endif *))
((* if spec.caption *))
{\fontsize{9.5}{12}\selectfont\rmfamily (((spec.caption)))\par}
((* endif *))

((* endmacro *))

((* macro metrics(entries) *))
\vspace{12pt}\noindent
((* for row in entries | batch(3) *))
\begin{tabular}[t]{@{}p{\dimexpr(\linewidth-48pt)/3\relax}@{\hspace{24pt}}p{\dimexpr(\linewidth-48pt)/3\relax}@{\hspace{24pt}}p{\dimexpr(\linewidth-48pt)/3\relax}@{}}
((* for m in row *))\scmetricvalue{(((m.label)))}{(((m.value)))}{(((m.detail)))}((* if not loop.last *)) & ((* endif *))((* endfor *))((* for _ in range(3 - (row | length)) *)) & ((* endfor *)) \\
\end{tabular}\par\vspace{18pt}
((* endfor *))

((* endmacro *))

((* macro status(level, headline, detail) *))
\begin{scstatusbox}{(((level | safe)))}{(((headline)))}
((* if detail *)){\rmfamily\fontsize{10}{13}\selectfont (((detail)))\par}((* else *))\vspace{-4pt}((* endif *))(((eol)))
\end{scstatusbox}\par

((* endmacro *))

((* macro alert(level, text) *))
((* set label_color = {'info': 'sc-blue', 'warning': 'sc-accent-ink', 'error': 'sc-red'}[level] *))
\begin{scalertbox}{(((level | safe)))}
{\bfseries\color{(((label_color | safe)))}(((level | upper)))}\hspace{10pt}{\rmfamily (((text)))}(((eol)))
\end{scalertbox}\par

((* endmacro *))

((* macro flow(stages) *))
\vspace{10pt}
((* for s in stages *))
\begin{scflowstage}{(((rails[s.state] | safe)))}
{\leftskip=26pt \noindent\hskip-26pt\makebox[26pt][l]{\color{sc-gray-500}\fontsize{9}{12}\selectfont (((('%02d' % s.number))))}{\fontsize{9.5}{12}\selectfont\bfseries (((s.label)))}\hspace{8pt}\scflowtag{(((rails[s.state] | safe)))}{(((s.state)))}\par
((* for line in s.detail *)){\fontsize{9}{12}\selectfont\color{sc-ink-soft}\rmfamily (((line)))\par}
((* endfor *))}
\end{scflowstage}\par
((* endfor *))
\vspace{12pt}

((* endmacro *))

((* macro metadata(entries) *))
{\fontsize{8.5}{11}\selectfont\setlength{\parskip}{0pt}
\vspace{10pt}\scrule{sc-ink}{0.9pt}\vspace{2pt}
((* for label, value in entries *))
\noindent\parbox[t]{\dimexpr0.32\linewidth-12pt\relax}{\bfseries\raggedright (((label)))}\hspace{12pt}\parbox[t]{0.68\linewidth}{\ttfamily\raggedright (((value)))}\par\vspace{2pt}
((* endfor *))
\scrule{sc-ink}{0.9pt}\vspace{10pt}}

((* endmacro *))

((* macro bullets(items, ordered) *))
((* set env = 'enumerate' if ordered else 'itemize' *))
{\scbody
\begin{(((env | safe)))}
((* for item in items *))
\item (((item)))
((* endfor *))
\end{(((env | safe)))}}

((* endmacro *))

((* macro code(source, language, caption, fence, verbatim) *))
\vspace{10pt}
((* if language *))
{\color{sc-gray-500}\fontsize{7.5}{10}\bfseries\selectfont\MakeUppercase{(((language)))}\par}\vspace{3pt}
((* endif *))
\begin{sccodebox}
\fontsize{8.5}{11}\ttfamily\selectfont
\begin{verbatim}
(((verbatim)))
\end{verbatim}
\end{sccodebox}
((* if caption *))
{\fontsize{9.5}{12}\selectfont\rmfamily (((caption)))\par}
((* endif *))

((* endmacro *))

((* macro details(summary, body) *))
\begin{scdetailsbox}{(((summary)))}
{\scbody (((body)))\par}
\end{scdetailsbox}\par

((* endmacro *))

((* macro note(body) *))
\begin{scnotebox}
\scbody (((body)))
\end{scnotebox}\par

((* endmacro *))

((* macro paragraph(body) *))
{\scbody (((body)))\par}

((* endmacro *))

((* macro fact(label, value) *))
{\scbody\noindent{\sffamily\bfseries (((label))):} (((value)))\par}

((* endmacro *))

((* macro attachment(link) *))
{\scbody((* if link.href *))\href{(((link.href | safe)))}{\texttt{\color{sc-blue}(((link.filename)))}}((* else *))\texttt{(((link.filename)))}((* endif *))((* if link.description *)) --- (((link.description)))((* endif *))((* if link.size *)) {\fontsize{9}{12}\selectfont\color{sc-ink-soft}(((lp)))(((link.size)))(((rp)))}((* endif *))\par}

((* endmacro *))

((* macro spacer(height) *))
\vspace{(((height)))pt}

((* endmacro *))

((* macro page_break() *))
\clearpage

((* endmacro *))

(((body)))
\end{scnotebox}\par

((* endmacro *))

((* macro paragraph(body) *))
(((body)))

((* endmacro *))

((* macro fact(label, value) *))
{\parskip=2pt\noindent{\bfseries\color{sc-ink}(((label))):} (((value)))\par}

((* endmacro *))

((* macro attachment(link) *))
((* if link.href *))\href{(((link.href | safe)))}{\uline{\texttt{\color{sc-ink}(((link.filename)))}}}((* else *))\texttt{(((link.filename)))}((* endif *))((* if link.description *)) --- (((link.description)))((* endif *))((* if link.size *)) {\fontsize{8.5}{12}\selectfont\color{sc-ink-soft}(((lp)))(((link.size)))(((rp)))}((* endif *))\par

((* endmacro *))

((* macro spacer(height) *))
\vspace{(((height)))pt}

((* endmacro *))


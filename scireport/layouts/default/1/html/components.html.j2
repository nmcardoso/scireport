{#- HTML components of default@1: the MOSAICS look. Autoescaping is on: plain strings are escaped, Safe ones are not.
    WeasyPrint workarounds kept from MOSAICS: no flex container inside another, a named cover page,
    no break-inside on tables. -#}
{% macro caption_text(label, number, text) -%}
{% if options.numbered_captions and number %}<span class="caption-label">{{ label }} {{ number }}.</span> {% endif %}{{ text }}
{%- endmacro %}

{% macro chapter(title, entry, page_break) %}
{% set flow = (not page_break) if page_break is not none else (not options.chapter_breaks) %}
<section class="chapter{{ ' chapter--listed' if entry.number else '' }}{{ ' chapter--flow' if flow else '' }}" id="{{ entry.anchor }}">
{% if entry.number %}
<div class="chapter-index chapter-index--total mono">{{ '%02d' % (entry.number | int) }}</div>
{% endif %}
<h1 class="h--chapter">{{ title }}</h1>
</section>
{% endmacro %}

{% macro heading(text, level, entry, page_break) %}
{% set tag = ['h2', 'h3', 'h4'][level - 1] %}
{% set style = ['h--section', 'h--subsection', 'h--minor'][level - 1] %}
<{{ tag }} id="{{ entry.anchor }}" class="{{ style }}{{ ' h--break' if page_break else '' }}{{ ' h--unlisted' if not entry.number else '' }}">{{ text }}</{{ tag }}>
{% endmacro %}

{% macro contents(entries) %}
<section class="toc">
<h2 class="h--section h--unlisted" id="toc">Contents</h2>
{% for e in entries %}
<div class="toc-row toc-row--{{ e.level }}"><a href="#{{ e.anchor }}">{% if e.level == 0 and e.number %}<span class="toc-number">{{ '%02d' % (e.number | int) }}</span>{% endif %}{{ e.text }}</a></div>
{% endfor %}
</section>
{% endmacro %}

{% macro cover(cover) %}
{% if options.cover %}
<section class="cover">
<div class="cover-field"></div>
<div class="cover-content">
{% if cover.pipeline %}
<div class="cover-label mono">{{ cover.pipeline }}</div>
{% endif %}
<h1 class="cover-title">{{ cover.title }}</h1>
{% if cover.subtitle %}
<p class="cover-subtitle mono">{{ cover.subtitle }}</p>
{% endif %}
{% if cover.authors %}
<div class="cover-authors">
{% for author in cover.authors %}
<p class="cover-author">{{ author }}</p>
{% endfor %}
</div>
{% endif %}
{% set facts = [] %}
{% if cover.date %}{% do facts.append(('Date', cover.date)) %}{% endif %}
{% if cover.version %}{% do facts.append(('Version', cover.version)) %}{% endif %}
{% if meta.keywords %}{% do facts.append(('Keywords', meta.keywords | join(', '))) %}{% endif %}
{% if facts %}
<div class="cover-meta">
{% for label, value in facts %}
<div class="cover-meta-row">
<span class="cover-meta-label mono">{{ label }}</span>
<span class="cover-meta-value mono">{{ value }}</span>
</div>
{% endfor %}
</div>
{% endif %}
</div>
</section>
{% else %}
<header class="title-block">
<h1 class="title-block-title">{{ cover.title }}</h1>
{% if cover.subtitle %}
<p class="title-block-subtitle">{{ cover.subtitle }}</p>
{% endif %}
</header>
{% endif %}
{% endmacro %}

{% macro table(spec) %}
{% if not spec.rows %}
<p class="p--muted">Nothing recorded.</p>
{% else %}
<div class="table-block">
<table>
<colgroup>
{% for col in spec.columns %}
<col style="width: {{ (col.width * 100) | round(3) }}%">
{% endfor %}
</colgroup>
{% if spec.headed %}
<thead>
<tr>
{% for col in spec.columns %}
<th class="align-{{ col.align if col.align in ['right', 'center'] else 'left' }}">{{ col.label }}{% if col.unit %} <span class="unit">({{ col.unit }})</span>{% endif %}</th>
{% endfor %}
</tr>
</thead>
{% endif %}
<tbody>
{% for row in spec.rows %}
<tr{% if row.verdict %} class="row--{{ row.verdict }}"{% endif %}>
{% for cell in row.cells %}
{% set col = spec.columns[loop.index0] %}
{% set style = row.emphasis[loop.index0] %}
{% set kind = 'path' if col.align == 'path' else ('num' if col.align == 'right' else 'text') %}
<td class="align-{{ col.align if col.align in ['right', 'center'] else 'left' }} cell--{{ kind }}{{ (' cell--' ~ style) if style else '' }}">{% if col.align == 'path' %}{{ cell | breakable }}{% else %}{{ cell }}{% endif %}</td>
{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
{% if spec.truncated %}
<p class="p--caption">Showing the first {{ spec.rows | length | fmt_int }} of {{ spec.total | fmt_int }} rows.{% if spec.overflow and spec.overflow.href %} <a href="{{ spec.overflow.href }}" download="{{ spec.overflow.filename }}">All rows ({{ spec.overflow.filename }})</a>.{% endif %}</p>
{% endif %}
{% if spec.caption %}
<p class="p--caption">{{ caption_text('Table', spec.number, spec.caption) }}</p>
{% endif %}
</div>
{% endif %}
{% endmacro %}

{% macro figure(spec) %}
<figure class="figure" id="figure-{{ spec.number }}">
<img src="{{ spec.src }}" alt="{{ spec.alt }}" style="width: {{ (spec.width * 100) | round(2) }}%;">
{% if spec.caption %}
<figcaption>{{ caption_text('Figure', spec.number, spec.caption) }}</figcaption>
{% endif %}
</figure>
{% endmacro %}

{% macro image(spec) %}
<figure class="figure">
<img src="{{ spec.src }}" alt="{{ spec.alt }}"{% if not spec.alt %} role="presentation"{% endif %} style="width: {{ (spec.width * 100) | round(2) }}%;">
{% if spec.caption %}
<figcaption>{{ spec.caption }}</figcaption>
{% endif %}
</figure>
{% endmacro %}

{% macro equation(spec) %}
<div class="equation">
<div class="equation-image">{{ spec.body }}</div>
{% if spec.number %}
<span class="equation-number mono">({{ spec.number }})</span>
{% endif %}
</div>
{% if spec.caption %}
<p class="p--caption">{{ spec.caption }}</p>
{% endif %}
{% endmacro %}

{% macro metrics(entries) %}
<div class="metric-grid">
{% for m in entries %}
<div class="metric">
<div class="metric-label">{{ m.label }}</div>
<div class="metric-value">{{ m.value }}</div>
{% if m.detail %}
<div class="metric-detail">{{ m.detail }}</div>
{% endif %}
</div>
{% endfor %}
</div>
{% endmacro %}

{% macro status(level, headline, detail) %}
<div class="status status--{{ level }}">
<span class="status-dot"></span>
<span class="status-headline">{{ headline }}</span>
{% if detail %}
<div class="status-detail">{{ detail }}</div>
{% endif %}
</div>
{% endmacro %}

{% macro alert(level, text) %}
<div class="alert alert--{{ level }}"><span class="alert-label">{{ level | upper }}</span><span class="alert-text">{{ text }}</span></div>
{% endmacro %}

{% macro flow(stages) %}
<div class="flow">
{% for s in stages %}
<div class="flow-stage flow-stage--{{ s.state }}">
<div class="flow-index mono">{{ '%02d' % s.number }}</div>
<div class="flow-body">
<div class="flow-label">{{ s.label }}</div>
{% for line in s.detail %}
<div class="flow-detail">{{ line }}</div>
{% endfor %}
</div>
</div>
{% endfor %}
</div>
{% endmacro %}

{% macro metadata(entries) %}
<div class="metadata">
{% for label, value in entries %}
<div class="metadata-row">
<span class="metadata-label">{{ label }}</span>
<span class="metadata-value mono">{{ value }}</span>
</div>
{% endfor %}
</div>
{% endmacro %}

{% macro bullets(items, ordered) %}
{% set tag = 'ol' if ordered else 'ul' %}
<{{ tag }} class="bullets">
{% for item in items %}
<li>{{ item }}</li>
{% endfor %}
</{{ tag }}>
{% endmacro %}

{% macro code(source, language, caption, fence, verbatim) %}
<div class="code-block-wrapper">
{% if language %}
<div class="code-language mono">{{ language }}</div>
{% endif %}
<pre class="code-block mono"><code{% if language %} class="language-{{ language }}"{% endif %}>{{ source }}</code></pre>
{% if caption %}
<p class="p--caption">{{ caption }}</p>
{% endif %}
</div>
{% endmacro %}

{% macro details(summary, body) %}
<details class="details" open>
<summary class="details-summary">{{ summary }}</summary>
{{ body }}
</details>
{% endmacro %}

{% macro note(body) %}
<div class="note">{{ body }}</div>
{% endmacro %}

{% macro paragraph(body) %}
<p>{{ body }}</p>
{% endmacro %}

{% macro fact(label, value) %}
<p class="fact"><span class="fact-label">{{ label }}:</span> {{ value }}</p>
{% endmacro %}

{% macro attachment(link) %}
<p class="attachment">{% if link.href %}<a href="{{ link.href }}" download="{{ link.filename }}">{{ link.filename }}</a>{% else %}<span class="mono">{{ link.filename }}</span>{% endif %}{% if link.description %} — {{ link.description }}{% endif %}{% if link.size %} <span class="p--muted">({{ link.size }})</span>{% endif %}</p>
{% endmacro %}

{% macro spacer(height) %}
<div class="spacer" style="height: {{ height }}pt;"></div>
{% endmacro %}

{% macro page_break() %}
<div class="page-break"></div>
{% endmacro %}

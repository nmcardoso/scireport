% ---- cover: full-bleed navy field, a 12 mm grid, a circle, the title block -------------------
% #1 label, #2 title, #3 subtitle, #4 authors (one \par each), #5 facts (rows of label & value)
\newcommand{\sccover}[5]{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[sc-navy-deep] (current page.south west) rectangle (current page.north east);
    \begin{scope}
      \clip (current page.south west) rectangle (current page.north east);
      \foreach \x in {0,12,...,240} {%
        \draw[white, opacity=0.06, line width=1pt]
          ($(current page.north west)+(\x mm,0)$) -- ($(current page.south west)+(\x mm,0)$);}
      \foreach \y in {0,12,...,300} {%
        \draw[white, opacity=0.06, line width=1pt]
          ($(current page.north west)+(0,-\y mm)$) -- ($(current page.north east)+(0,-\y mm)$);}
    \end{scope}
    \draw[sc-blue-light, opacity=0.25, line width=0.75pt]
      ($(current page.south east)+(-63mm,63mm)$) circle (45mm);
    \node[anchor=north west, inner sep=0pt, text width=162mm, align=left, text=white]
      at ($(current page.north west)+(24mm,-60mm)$) {%
      \ifstrempty{#1}{}{{\color{sc-cyan-light}\fontsize{9}{12}\ttfamily\selectfont
        \sctrack{\MakeUppercase{#1}}}\par\vspace{24pt}}%
      \parbox{130mm}{\raggedright\fontsize{34}{39}\selectfont\bfseries\color{white}#2}\par\vspace{16pt}%
      \ifstrempty{#3}{}{\parbox{130mm}{\raggedright\fontsize{10.5}{16}\ttfamily\selectfont
        \color{sc-blue-light}#3}\par\vspace{12pt}}%
      {\fontsize{9}{14}\selectfont\color{sc-gray-300}\setlength{\parskip}{0pt}#4\par}%
      \vspace{48pt}%
      {\fontsize{8.5}{13}\ttfamily\selectfont\setlength{\tabcolsep}{0pt}%
        \begin{tabular}{@{}>{\color{sc-gray-300}\sctrackon}l@{\hspace{16pt}}>{\color{white}}l@{}}
          #5
        \end{tabular}}%
    };
  \end{tikzpicture}%
  \clearpage}

% A plain title block, for `cover: false`.
\newcommand{\sctitleblock}[2]{%
  {\fontsize{33}{40}\selectfont\bfseries\color{sc-navy}#1\par}%
  \ifstrempty{#2}{}{\vspace{8pt}{\ttfamily\fontsize{10.5}{16}\selectfont\color{sc-ink-soft}#2\par}}%
  \vspace{24pt}}

% A rule over the whole frame; \rlap keeps TeX from reporting an overfull box.
\newcommand{\scrule}[2]{\noindent\rlap{\textcolor{#1}{\rule{\scfullwidth}{#2}}}\par}

% ---- headings -------------------------------------------------------------------------------------
% \scanchor{anchor}{pdf text}{pdf level}: a target for the table of contents and the PDF outline.
\newcommand{\scanchor}[3]{%
  \phantomsection\label{#1}%
  \ifstrempty{#3}{}{\pdfbookmark[#3]{#2}{#1}}}

% \scchapter{index}{title}{anchor}{pdf text}{flow}: index is "01" or empty; flow is 0 or 1.
\newcommand{\scchapter}[5]{%
  \ifnumequal{#5}{0}{\clearpage\vspace*{85mm}}{\par\vspace{24pt}}%
  \ifstrempty{#1}{\scanchor{#3}{#4}{}}{\stepcounter{scchapter}\scanchor{#3}{#4}{0}%
    {\color{sc-gray-500}\fontsize{9}{12}\ttfamily\selectfont
      \sctrack{#1\ /\ \sc@zero{\sc@total}}\par\vspace{8pt}}}%
  {\raggedright\fontsize{33}{40}\selectfont\bfseries\color{sc-navy}#2\par}%
  \vspace{8pt}}

% \scheading{level}{title}{anchor}{pdf text}{listed}{break}
\newcommand{\scheading}[6]{%
  \ifnumequal{#6}{1}{\clearpage}{\ifnumcomp{#1}{=}{1}{\needspace{9\baselineskip}}{\needspace{6\baselineskip}}}%
  \ifnumequal{#5}{1}{\scanchor{#3}{#4}{#1}}{\scanchor{#3}{#4}{}}%
  \ifnumcomp{#1}{=}{1}{%
    \vspace{32pt}%
    {\fontsize{20}{24}\selectfont\bfseries\color{sc-navy}#2\par}%
    \vspace{2pt}\scrule{sc-gray-200}{1pt}\vspace{12pt}}{%
  \ifnumcomp{#1}{=}{2}{%
    \vspace{16pt}%
    {\fontsize{14}{17}\selectfont\bfseries\color{sc-ink}#2\par}\vspace{8pt}}{%
    \vspace{12pt}%
    {\fontsize{10}{12}\selectfont\bfseries\color{sc-ink-soft}\sctrack{\MakeUppercase{#2}}\par}\vspace{8pt}}}}

% ---- table of contents --------------------------------------------------------------------------
% \sctocrow{level}{number}{title}{anchor}
\newcommand{\sctocrow}[4]{%
  \par\vspace{\ifnumequal{#1}{0}{12pt}{0pt}}%
  {\noindent\leftskip=\ifcase#1 0pt\or 16pt\or 32pt\else 48pt\fi\relax
   \rightskip=3em\relax \parfillskip=-\rightskip
   \ifnumcomp{#1}{=}{0}{\bfseries}{\ifnumcomp{#1}{>}{1}{\small\color{sc-ink-soft}}{}}%
   \hyperref[#4]{\ifstrempty{#2}{}{{\ttfamily\mdseries\color{sc-ink-soft}#2}\hspace{1.2em}}#3}%
   \nobreak\hfill\nobreak
   \hbox to 3em{\hfill\ttfamily\mdseries\color{sc-gray-500}\pageref{#4}}\par}%
  \vspace{-4pt}\scrule{sc-gray-100}{0.5pt}}

% ---- boxes (status, alert, flow, details, note, code) ------------------------------------------
\tcbset{
  scbase/.style={enhanced, boxrule=0pt, arc=0pt, frame hidden, colback=sc-gray-50, coltext=sc-ink, before skip=16pt, after skip=20pt,
    left=19pt, right=16pt, top=12pt, bottom=12pt},
  scalertbox/.style={scbase, before skip=4pt, after skip=4pt, left=15pt, top=8pt, bottom=8pt,
    right=12pt},
}
\newcommand{\sc@bar}[2]{\draw[line width=#1, color=#2] ([xshift=#1/2]frame.south west) --
  ([xshift=#1/2]frame.north west);}
% \scstatusbox{level}: success, warning, partial, failed or running
\newtcolorbox{scstatusbox}[1]{scbase,
  overlay={%
    \ifstrequal{#1}{success}{\sc@bar{3pt}{sc-green}}{}%
    \ifstrequal{#1}{warning}{\draw[line width=3pt, color=sc-accent, dash pattern=on 6pt off 4pt]
      ([xshift=1.5pt]frame.south west) -- ([xshift=1.5pt]frame.north west);}{}%
    \ifstrequal{#1}{partial}{\draw[line width=4pt, color=sc-accent, line cap=round,
      dash pattern=on 0pt off 5pt] ([xshift=2pt]frame.south west) -- ([xshift=2pt]frame.north west);}{}%
    \ifstrequal{#1}{failed}{\draw[line width=5pt, color=sc-red]
      ([xshift=2.5pt]frame.south west) -- ([xshift=2.5pt]frame.north west);
      \draw[line width=1.6pt, color=sc-gray-50]
      ([xshift=2.5pt]frame.south west) -- ([xshift=2.5pt]frame.north west);}{}%
    \ifstrequal{#1}{running}{\draw[line width=3pt, color=sc-cyan, line cap=round,
      dash pattern=on 0pt off 4pt] ([xshift=1.5pt]frame.south west) -- ([xshift=1.5pt]frame.north west);}{}%
  }}
\newcommand{\scdot}[2]{\tikz[baseline=-0.6ex]{\path[fill=#1, draw=#2, line width=1.5pt]
  (0,0) circle (3.75pt);}}
% \scalertbox{level}: info, warning or error
\newtcolorbox{scalertbox}[1]{scalertbox,
  overlay={%
    \ifstrequal{#1}{info}{\sc@bar{3pt}{sc-blue}}{}%
    \ifstrequal{#1}{warning}{\sc@bar{3pt}{sc-accent}}{}%
    \ifstrequal{#1}{error}{\sc@bar{3pt}{sc-red}}{}}}
\newtcolorbox{scnotebox}{enhanced, breakable, boxrule=0pt, arc=0pt, colback=white, frame hidden,
  borderline west={1.5pt}{0pt}{sc-gray-300}, coltext=sc-ink-soft, left=12pt, right=0pt, top=2pt,
  bottom=2pt, before skip=12pt, after skip=12pt, enlarge right by=0pt}
\newtcolorbox{scdetailsbox}{enhanced, breakable, boxrule=0.5pt, colframe=sc-gray-200,
  colback=sc-gray-50, coltext=sc-ink, arc=0pt, left=12pt, right=12pt, top=8pt, bottom=8pt,
  before skip=12pt, after skip=12pt}
\newtcolorbox{sccodebox}{enhanced, breakable, boxrule=0pt, arc=0pt, colback=sc-navy-deep,
  coltext=sc-code-ink, left=16pt, right=16pt, top=12pt, bottom=12pt, before skip=0pt,
  after skip=16pt}
% One stage of a flow; #1 is the dot fill and #2 its outline.
\newtcolorbox{scflowstage}[2]{enhanced, boxrule=0pt, arc=0pt, frame hidden, colback=white,
  coltext=sc-ink, borderline west={2pt}{0pt}{sc-gray-300}, left=16pt, right=0pt, top=8pt,
  bottom=8pt, before skip=1pt, after skip=0pt,
  overlay={\path[fill=#1, draw=#2, line width=1.5pt] ([xshift=-1pt,yshift=-11.5pt]frame.north west)
    circle (3.75pt);}}

\newcommand{\scmetricvalue}[3]{%
  {\color{sc-gray-500}\fontsize{7.5}{9}\ttfamily\selectfont\sctrack{\MakeUppercase{#1}}}\par\vspace{3pt}%
  {\fontsize{22}{24}\selectfont\bfseries\color{sc-navy}#2}\par
  \ifstrempty{#3}{}{\vspace{2pt}{\fontsize{8}{11}\selectfont\color{sc-ink-soft}#3}\par}}


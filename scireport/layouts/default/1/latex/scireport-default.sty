\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{scireport-default}[2026/10/09 scireport default layout (the MOSAICS look), version 1]
%
% Works with LuaLaTeX (default), XeLaTeX and pdfLaTeX. Inter and IBM Plex Mono are loaded from the
% fonts/ folder of the project through fontspec; pdfLaTeX cannot read OpenType fonts, so it falls
% back to Latin Modern with a warning (W901).
%
% Geometry: the text column is narrower than the page frame, as the paragraphs of the HTML look
% are (max-width: 68ch). Tables, figures and the dashboard blocks use the full frame width,
% \scfullwidth, by reaching \scoverhang into the right margin.
\RequirePackage{iftex}
\RequirePackage{etoolbox}

\DeclareOption{a4}{\def\sc@paper{a4paper}}
\DeclareOption{letter}{\def\sc@paper{letterpaper}}
\ExecuteOptions{a4}
\ProcessOptions\relax

% ---- fonts -------------------------------------------------------------------------------------
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{lmodern}
  \RequirePackage{textcomp}
  \renewcommand{\familydefault}{\sfdefault}
  \PackageWarningNoLine{scireport-default}{%
    W901: pdfLaTeX cannot load the OpenType fonts Inter and IBM Plex Mono; using Latin Modern Sans
    and Typewriter. Use LuaLaTeX or XeLaTeX for the designed look}
  \newcommand{\sctrack}[1]{#1}
  \newcommand{\sctrackon}{}
\else
  \RequirePackage{lmodern}
  \RequirePackage{fontspec}
  \setmainfont{Inter}[Path=./fonts/, Extension=.otf, Ligatures=TeX,
    UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-SemiBold, BoldItalicFont=*-Italic]
  \setsansfont{Inter}[Path=./fonts/, Extension=.otf, Ligatures=TeX,
    UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-SemiBold, BoldItalicFont=*-Italic]
  \setmonofont{IBMPlexMono}[Path=./fonts/, Extension=.otf, Scale=MatchLowercase,
    UprightFont=*-Regular, ItalicFont=*-Regular, BoldFont=*-Medium, BoldItalicFont=*-Medium]
  \newcommand{\sctrack}[1]{{\addfontfeatures{LetterSpace=8}#1}}
  \newcommand{\sctrackon}{\addfontfeatures{LetterSpace=8}}
  % The vendored subsets have no bullet glyph.
  \renewcommand{\textbullet}{\ensuremath{\bullet}}
\fi

